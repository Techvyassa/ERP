APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=control

# Control Database Configuration (ERP_saas_control)
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_DATABASE=ERP_saas_control
CONTROL_DB_USERNAME=root
CONTROL_DB_PASSWORD=

# Tenant Database Configuration (erp_{slug})
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=

# ============================================================================
# TENANT CONFIGURATION
# ============================================================================

# Tenant database prefix (e.g., erp_acme, erp_techcorp)
TENANT_DB_PREFIX=erp_

# Tenant database connection settings (defaults to main DB settings if not specified)
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_USERNAME=root
# TENANT_DB_PASSWORD=
# TENANT_DB_CHARSET=utf8mb4
# TENANT_DB_COLLATION=utf8mb4_unicode_ci

# Tenant provisioning settings
TENANT_PROVISIONING_QUEUE=default
TENANT_PROVISIONING_QUEUE_NAME=tenant-provisioning
TENANT_PROVISIONING_TIMEOUT=300
TENANT_PROVISIONING_MAX_ATTEMPTS=3
TENANT_SEND_WELCOME_EMAIL=true
TENANT_ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Default tenant settings
TENANT_DEFAULT_TIMEZONE=UTC
TENANT_DEFAULT_CURRENCY=USD
TENANT_DEFAULT_COUNTRY=US
TENANT_DEFAULT_MAX_USERS=10

# Tenant isolation settings
TENANT_LOG_CONNECTION_SWITCHES=true
TENANT_VERIFY_DATABASE_EXISTS=true
TENANT_CACHE_RESOLUTION=true
TENANT_CACHE_TTL=300

# ============================================================================
# SUBSCRIPTION CONFIGURATION
# ============================================================================

# Trial subscription settings
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_AUTO_CREATE_TRIAL=true
SUBSCRIPTION_TRIAL_PLAN_CODE=TRIAL

# Grace period settings
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_GRACE_ALLOW_READ_ONLY=true
SUBSCRIPTION_GRACE_SEND_REMINDERS=true

# Subscription cache settings
SUBSCRIPTION_CACHE_ENABLED=true
SUBSCRIPTION_CACHE_TTL=300

# Scheduled jobs configuration
SUBSCRIPTION_JOB_CHECK_TRIALS=true
SUBSCRIPTION_JOB_CHECK_TRIALS_SCHEDULE="0 0 * * *"
SUBSCRIPTION_JOB_PROCESS_RENEWALS=true
SUBSCRIPTION_JOB_PROCESS_RENEWALS_SCHEDULE="0 1 * * *"
SUBSCRIPTION_JOB_ENFORCE_GRACE=true
SUBSCRIPTION_JOB_ENFORCE_GRACE_SCHEDULE="0 2 * * *"

# Cancellation settings
SUBSCRIPTION_CANCEL_ALLOW_UNTIL_END=true
SUBSCRIPTION_CANCEL_REQUIRE_REASON=true
SUBSCRIPTION_CANCEL_SEND_CONFIRMATION=true
SUBSCRIPTION_CANCEL_OFFER_RETENTION=false

# Plan change settings
SUBSCRIPTION_ALLOW_MID_CYCLE_CHANGES=true
SUBSCRIPTION_PRORATE_UPGRADES=true
SUBSCRIPTION_PRORATE_DOWNGRADES=true
SUBSCRIPTION_APPLY_CHANGES_IMMEDIATELY=true

# Notification settings
SUBSCRIPTION_EMAIL_STATUS_CHANGE=true
SUBSCRIPTION_EMAIL_BEFORE_RENEWAL=7
SUBSCRIPTION_EMAIL_PAYMENT_FAILURE=true
SUBSCRIPTION_ADMIN_EMAIL=admin@example.com

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Default payment gateway (razorpay or stripe)
PAYMENT_DEFAULT_GATEWAY=razorpay

# Razorpay configuration
PAYMENT_RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_TEST_MODE=true
RAZORPAY_API_URL=https://api.razorpay.com/v1

# Stripe configuration
PAYMENT_STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=USD
STRIPE_TEST_MODE=true
STRIPE_API_VERSION=2023-10-16

# Payment processing settings
PAYMENT_API_TIMEOUT=30
PAYMENT_RETRY_FAILED=true
PAYMENT_MAX_RETRY_ATTEMPTS=3
PAYMENT_RETRY_DELAY_HOURS=24
PAYMENT_REFERENCE_PREFIX=PAY
PAYMENT_QUEUE_CONNECTION=default
PAYMENT_QUEUE_NAME=payments

# Tax calculation settings
PAYMENT_TAX_METHOD=country_based
PAYMENT_INDIA_CGST_RATE=9.0
PAYMENT_INDIA_SGST_RATE=9.0
PAYMENT_INDIA_IGST_RATE=18.0
PAYMENT_ALLOW_TAX_EXEMPTIONS=false

# Refund settings
PAYMENT_REFUNDS_ENABLED=true
PAYMENT_REFUND_METHOD=gateway
PAYMENT_MAX_REFUND_PERIOD=90
PAYMENT_ALLOW_PARTIAL_REFUNDS=true
PAYMENT_REFUND_REQUIRE_APPROVAL=true
PAYMENT_REFUND_SEND_CONFIRMATION=true

# Payment ledger settings
PAYMENT_LEDGER_IMMUTABLE=true
PAYMENT_LEDGER_PREVENT_DELETION=true
PAYMENT_AUDIT_LOGGING=true
PAYMENT_RETENTION_PERIOD=0

# Webhook security
PAYMENT_WEBHOOK_VERIFY_SIGNATURES=true
PAYMENT_WEBHOOK_TIMEOUT=10
PAYMENT_WEBHOOK_LOG_REQUESTS=true
PAYMENT_WEBHOOK_ALLOWED_IPS=
PAYMENT_WEBHOOK_RATE_LIMIT=100

# Payment notifications
PAYMENT_EMAIL_ON_SUCCESS=true
PAYMENT_EMAIL_ON_FAILURE=true
PAYMENT_EMAIL_ON_REFUND=true
PAYMENT_ADMIN_EMAIL=admin@example.com
PAYMENT_NOTIFY_ADMIN_ON_FAILURE=true

# Currency settings
PAYMENT_DEFAULT_CURRENCY=USD
PAYMENT_CURRENCY_CONVERSION=false
PAYMENT_CONVERSION_API=exchangerate-api
PAYMENT_CONVERSION_API_KEY=
PAYMENT_CONVERSION_CACHE_HOURS=24

# Testing settings
PAYMENT_FORCE_TEST_MODE=false
PAYMENT_MOCK_GATEWAY=false


# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================

